# BroLab Test Environment Configuration
# Copy this file to .env.test and fill in your test credentials

# ============================================
# Stripe Test Mode Configuration
# ============================================
# Get these from: https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_YOUR_TEST_SECRET_KEY_HERE
STRIPE_PUBLISHABLE_KEY=pk_test_YOUR_TEST_PUBLISHABLE_KEY_HERE

# Webhook Secret for local testing
# Generate with: stripe listen --forward-to localhost:3000/api/stripe/webhook
# Or get from Stripe Dashboard > Developers > Webhooks
STRIPE_CONNECT_WEBHOOK_SECRET=whsec_YOUR_WEBHOOK_SECRET_HERE

# ============================================
# Application URLs
# ============================================
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_CONVEX_URL=https://your-test-deployment.convex.cloud

# ============================================
# Convex Configuration
# ============================================
# Get from: https://dashboard.convex.dev/deployment/settings
CONVEX_DEPLOYMENT=dev:your-deployment-name
NEXT_PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud

# ============================================
# Test User Credentials (Optional)
# ============================================
# For E2E authentication tests
TEST_USER_EMAIL=test@example.com
TEST_USER_PASSWORD=SecureTestPassword123!

# ============================================
# Clerk Authentication (Test Mode)
# ============================================
# Get from: https://dashboard.clerk.com/
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_YOUR_CLERK_KEY_HERE
CLERK_SECRET_KEY=sk_test_YOUR_CLERK_SECRET_HERE

# Sign-in/up URLs
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/studio
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/studio

# ============================================
# Test Data Configuration
# ============================================
# These should match your Convex test database
TEST_WORKSPACE_ID=test_workspace_001
TEST_WORKSPACE_STRIPE_ACCOUNT=acct_test_YOUR_CONNECTED_ACCOUNT_ID

# Sample test items
TEST_TRACK_ID=track_001
TEST_SERVICE_ID=service_001

# ============================================
# Playwright Test Configuration
# ============================================
# Browser to use for tests
PLAYWRIGHT_BROWSER=chromium

# Test timeout (milliseconds)
PLAYWRIGHT_TIMEOUT=30000

# ============================================
# Feature Flags (Optional)
# ============================================
ENABLE_TEST_MODE=true
MOCK_STRIPE_WEBHOOKS=false
SKIP_SIGNATURE_VERIFICATION=false

# ============================================
# Notes
# ============================================
# 1. Never commit the actual .env.test file to version control
# 2. Use Stripe test mode keys only (sk_test_*, pk_test_*)
# 3. For local webhook testing, run: stripe listen --forward-to localhost:3000/api/stripe/webhook
# 4. Test cards: 4242 4242 4242 4242 (success), 4000 0000 0000 0002 (decline)
# 5. Keep test data separate from production data
