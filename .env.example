# System Environment (for Playwright/browser tools)
# Windows: Set to your user profile directory (e.g., C:\Users\YourUsername)
# Linux/Mac: Usually /home/username or /Users/username
# Replace placeholder values before running the app.
# Rotate every secret before production deployment and every 90 days afterward.
HOME=C:\Users\%USERNAME%

# Clerk Authentication
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/onboarding

# Convex
NEXT_PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud
CLERK_JWT_ISSUER_DOMAIN=https://your-clerk-domain.clerk.accounts.dev
CONVEX_DEPLOYMENT=dev:your-deployment-name

# Stripe Platform Account (for Clerk Billing - provider subscriptions)
# Get from: https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Stripe Connect (for artist purchases → provider accounts)
# Same keys as above, but used for Connect operations
# Connect Client ID: Get from https://dashboard.stripe.com/test/settings/applications
STRIPE_CONNECT_CLIENT_ID=ca_...

# Stripe Webhooks
# Platform webhook (for Clerk Billing events): https://dashboard.stripe.com/test/webhooks
STRIPE_WEBHOOK_SECRET=whsec_...
# Connect webhook (for artist purchase events): Create separate endpoint for Connect events
STRIPE_CONNECT_WEBHOOK_SECRET=whsec_...

# Resend (Email)
RESEND_API_KEY=re_...

# Site Configuration
# Production should use the public https origin, never localhost.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Brand Info
BRAND_NAME=BroLab Entertainment
BRAND_EMAIL=contact@brolabentertainment.com
BRAND_ADDRESS="Your Address"
BRAND_PHONE=+1234567890
BRAND_WEBSITE=https://brolabentertainment.com
