{
  "name": "brolab-entertainment",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:chrome": "node scripts/lint-chrome-surfaces.mjs",
    "lint:surfaces": "node scripts/lint-surfaces.mjs",
    "typecheck": "tsc --noEmit",
    "build:worker": "tsc -p worker/tsconfig.json",
    "worker": "node dist/worker/index.js",
    "test": "vitest",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:watch": "vitest watch",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test tests/e2e",
    "test:security": "playwright test tests/security/",
    "test:all": "npm run test:unit && npm run test:integration && npm run test:e2e && npm run test:security",
    "security:jwt": "bash scripts/verify-jwt-security.sh"
  },
  "dependencies": {
    "@clerk/nextjs": "6.36.5",
    "@clerk/themes": "^2.4.57",
    "convex": "1.31.6",
    "dotenv": "^17.4.0",
    "framer-motion": "^12.38.0",
    "lucide-react": "0.469.0",
    "next": "15.5.12",
    "next-themes": "^0.4.6",
    "pdf-lib": "1.17.1",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "resend": "^6.10.0",
    "stripe": "17.5.0",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.5",
    "@eslint/js": "^9.39.4",
    "@next/eslint-plugin-next": "15.5.12",
    "@playwright/test": "^1.59.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "22.10.5",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^4.1.2",
    "eslint": "9.17.0",
    "eslint-config-next": "15.5.12",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "glob": "^13.0.6",
    "jsdom": "^26.0.0",
    "tailwindcss": "3.4.17",
    "typescript": "5.7.2",
    "typescript-eslint": "^8.58.0",
    "vitest": "^4.1.2"
  }
}
