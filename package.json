{
  "name": "brolab-entertainment",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:chrome": "node scripts/lint-chrome-surfaces.mjs",
    "lint:surfaces": "node scripts/lint-surfaces.mjs",
    "typecheck": "tsc --noEmit",
    "check-env": "node scripts/check-env.mjs",
    "build:worker": "tsc -p worker/tsconfig.json",
    "worker": "node dist/worker/index.js",
    "test": "vitest",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:watch": "vitest watch",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:security": "playwright test tests/security/",
    "test:all": "npm run test:unit && npm run test:integration && npm run test:e2e && npm run test:security",
    "security:jwt": "bash scripts/verify-jwt-security.sh",
    "paperclip": "bash scripts/launch-paperclip.sh",
    "paperclip:verify": "bash scripts/verify-paperclip-instance.sh"
  },
  "dependencies": {
    "@clerk/nextjs": "^7.5.22",
    "@clerk/themes": "^2.4.57",
    "convex": "^1.42.3",
    "dotenv": "^17.4.2",
    "framer-motion": "^12.42.2",
    "lucide-react": "^1.24.0",
    "next": "^16.2.11",
    "next-themes": "^0.4.6",
    "pdf-lib": "1.17.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "resend": "^6.17.2",
    "stripe": "^22.3.2",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.5",
    "@eslint/js": "^10.0.1",
    "@next/eslint-plugin-next": "^16.2.11",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4.3.2",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^25.9.5",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.6.0",
    "eslint-config-next": "^16.2.11",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "glob": "^13.0.6",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4.3.2",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.63.0",
    "vitest": "^4.1.10"
  }
}
